[node name="StoryText" type="RichTextLabel" parent="TextPanel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#e8cf9a]清光緒末年[/color],上海開埠已逾半個甲子。\n外灘汽笛日夜不息,洋行旗幟插滿十里洋場——這裡是冒險家的樂園,也是無數商號的墳場。\n\n錦記綢緞莊,曾是名噪一時的老字號。老掌櫃驟逝,洋行壓價、同行環伺,賬上只餘三百兩碎銀。\n[color=#d98f8f]人人都在等著看笑話:一個寡居的女人,撐不起這扇門面。[/color]\n\n今夜,一封燙金請帖送到案頭——英商亨利洋行的買辦[color=#e8cf9a]克勞迪[/color],願與錦記「談一談」。\n一紙大單,足以翻身;一步踏錯,萬劫不復。\n\n她對著銅鏡理了理衣襟,輕聲道——\n[color=#f7ead0][i]「開門,迎客。」[/i][/color]"
fit_content = true
scroll_active = false
theme_override_colors/default_color = Color(0.88, 0.84, 0.75, 1)
theme_override_constants/line_separation = 8
theme_override_font_sizes/normal_font_size = 18

